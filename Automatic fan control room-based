#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <DHT.h>

#define DHTPIN D4         // DHT22 data pin
#define DHTTYPE DHT22
#define RELAY_PIN D5      // Relay control pin

const char* ssid = "Divya sree";        // 🔹 Change this
const char* password = "lavadivya"; // 🔹 Change this

DHT dht(DHTPIN, DHTTYPE);
ESP8266WebServer server(80);

float temperature;
float humidity;
String fanStatus = "OFF";

// Set threshold for fan activation
const float TEMP_THRESHOLD = 30.0;  // Fan turns ON above 30°C

void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nConnected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  dht.begin();
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW);  // Start with fan OFF

  server.on("/", handleRoot);
  server.on("/read", handleRead);
  server.begin();
  Serial.println("Web server started.");
}

void loop() {
  server.handleClient();
  updateFanControl();
}

void updateFanControl() {
  temperature = dht.readTemperature();
  humidity = dht.readHumidity();

  if (isnan(temperature) || isnan(humidity)) return;

  if (temperature > TEMP_THRESHOLD) {
    digitalWrite(RELAY_PIN, HIGH);  // Fan ON
    fanStatus = "ON";
  } else {
    digitalWrite(RELAY_PIN, LOW);   // Fan OFF
    fanStatus = "OFF";
  }
}

void handleRoot() {
  String html = "<!DOCTYPE html><html><head>";
  html += "<meta http-equiv='refresh' content='1'>";
  html += "<title>Automatic Fan Control</title>";
  html += "<style>";
  html += "body{font-family:Arial;background:#f2f2f2;text-align:center;}";
  html += "h2{color:#333;}";
  html += "table{margin:auto;border-collapse:collapse;width:60%;}";
  html += "th,td{border:2px solid #555;padding:10px;font-size:18px;}";
  html += "th{background-color:#4CAF50;color:white;}";
  html += "td{background-color:white;}";
  html += ".status-on{color:green;font-weight:bold;}";
  html += ".status-off{color:red;font-weight:bold;}";
  html += "</style></head><body>";
  html += "<h2>🌡️ Automatic Fan Control (ESP8266 + DHT22)</h2>";
  html += "<table>";
  html += "<tr><th>Parameter</th><th>Value</th></tr>";
  html += "<tr><td>Temperature (°C)</td><td>" + String(temperature, 1) + "</td></tr>";
  html += "<tr><td>Humidity (%)</td><td>" + String(humidity, 1) + "</td></tr>";
  html += "<tr><td>Fan Status</td><td class='" + String((fanStatus == "ON") ? "status-on" : "status-off") + "'>" + fanStatus + "</td></tr>";
  html += "</table>";
  html += "<p>Threshold Temperature: <b>" + String(TEMP_THRESHOLD) + "°C</b></p>";
  html += "<p>Auto refreshes every 1 second</p>";
  html += "</body></html>";

  server.send(200, "text/html", html);
}
