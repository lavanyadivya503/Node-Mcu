
#include <ESP8266WiFi.h>

// 🏠 Wi-Fi credentials
const char* ssid = "Divyasree";
const char* password = "lavadivya";

// 🌐 Web server on port 80
WiFiServer server(80);

// ⚙️ Pin setup
const int trigPin = D1;
const int echoPin = D2;
const int redLED = D5;
const int yellowLED = D6;
const int greenLED = D7;
const int buzzer = D8;

// 🚰 Tank details
const int tankHeight = 20; // Full height in cm
const int numReadings = 5;

long readDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH);
  long distance = duration * 0.034 / 2;
  return distance;
}

void setup() {
  Serial.begin(115200);
  delay(10);

  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(redLED, OUTPUT);
  pinMode(yellowLED, OUTPUT);
  pinMode(greenLED, OUTPUT);
  pinMode(buzzer, OUTPUT);

  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("WiFi connected ✅");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());

  server.begin();
  Serial.println("Server started 🚀");
}

void loop() {
  // 📏 Measure average distance
  long totalDistance = 0;
  for (int i = 0; i < numReadings; i++) {
    totalDistance += readDistance();
    delay(50);
  }
  int distance = totalDistance / numReadings;
  int waterLevel = tankHeight - distance;
  if (waterLevel < 0) waterLevel = 0;
  if (waterLevel > tankHeight) waterLevel = tankHeight;

  String status;

  // 🧠 New LED Logic
  if (waterLevel < 5) {  // Tank almost empty
    digitalWrite(redLED, HIGH);
    digitalWrite(yellowLED, LOW);
    digitalWrite(greenLED, LOW);
    digitalWrite(buzzer, HIGH);
    status = "LOW (EMPTY)";
  } 
  else if (waterLevel < 16) {  // Half full
    digitalWrite(redLED, LOW);
    digitalWrite(yellowLED, HIGH);
    digitalWrite(greenLED, LOW);
    digitalWrite(buzzer, LOW);
    status = "MEDIUM (HALF FULL)";
  } 
  else {  // Full
    digitalWrite(redLED, LOW);
    digitalWrite(yellowLED, LOW);
    digitalWrite(greenLED, HIGH);
    digitalWrite(buzzer, LOW);
    status = "FULL (TANK COMPLETE)";
  }

  // 🌐 Web page
  WiFiClient client = server.available();
  if (client) {
    String request = client.readStringUntil('\r');
    client.flush();

    String html = "<!DOCTYPE html><html><head><title>ESP8266 Water Level</title>"
                  "<meta name='viewport' content='width=device-width, initial-scale=1'>"
                  "<style>body{font-family:Arial;text-align:center;background:#e3f2fd;}"
                  "table{margin:auto;border-collapse:collapse;width:60%;font-size:20px;}"
                  "th,td{padding:12px;border:1px solid #0277bd;}"
                  "th{background:#0288d1;color:white;}</style></head><body>"
                  "<h2>💧 ESP8266 Water Level Monitoring System</h2>"
                  "<table><tr><th>Parameter</th><th>Value</th></tr>"
                  "<tr><td>Water Level (cm)</td><td>" + String(waterLevel) + "</td></tr>"
                  "<tr><td>Status</td><td>" + status + "</td></tr>"
                  "<tr><td>Tank Height (cm)</td><td>" + String(tankHeight) + "</td></tr>"
                  "</table><p>LED and buzzer updated automatically.</p></body></html>";

    client.println("HTTP/1.1 200 OK");
    client.println("Content-Type: text/html");
    client.println("Connection: close");
    client.println();
    client.println(html);
    client.stop();
  }

  delay(1000);
}
