#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

#define SOIL_PIN A0
#define RELAY_PIN D1

// Your Wi-Fi details
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

ESP8266WebServer server(80);

// Thresholds
const int NO_PROBE_VALUE = 950;
const int DRY_THRESHOLD = 25;
const int WET_THRESHOLD = 60;

String motorStatus = "OFF";

void handleRoot() {
  int sensorValue = analogRead(SOIL_PIN);
  int moisturePercent = map(sensorValue, 1023, 0, 0, 100);

  String soilStatus;

  if (sensorValue > NO_PROBE_VALUE) {
    soilStatus = "No Soil Detected";
    digitalWrite(RELAY_PIN, LOW);
    motorStatus = "OFF";
  } else if (moisturePercent < DRY_THRESHOLD) {
    soilStatus = "Dry";
    digitalWrite(RELAY_PIN, HIGH);
    motorStatus = "ON";
  } else if (moisturePercent < WET_THRESHOLD) {
    soilStatus = "Moist";
    digitalWrite(RELAY_PIN, LOW);
    motorStatus = "OFF";
  } else {
    soilStatus = "Wet";
    digitalWrite(RELAY_PIN, LOW);
    motorStatus = "OFF";
  }

  // ---------- HTML PAGE ----------
  String page = "<!DOCTYPE html><html><head>";
  page += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
  page += "<title>Smart Irrigation</title>";
  page += "<style>";
  page += "body{font-family:Arial;background:#E3F2FD;padding:20px;}";
  page += "table{width:100%;border-collapse:collapse;font-size:20px;}";
  page += "th,td{border:1px solid #000;padding:12px;text-align:center;}";
  page += "th{background:#0288D1;color:white;}";
  page += "td{background:white;}";
  page += ".statusOn{color:green;font-weight:bold;}";
  page += ".statusOff{color:red;font-weight:bold;}";
  page += "</style></head><body>";

  page += "<h2>🌱 Smart Irrigation System</h2>";
  page += "<table>";
  page += "<tr><th>Parameter</th><th>Value</th></tr>";
  page += "<tr><td>Raw Soil Value</td><td>" + String(sensorValue) + "</td></tr>";
  page += "<tr><td>Moisture (%)</td><td>" + String(moisturePercent) + "%</td></tr>";
  page += "<tr><td>Soil Condition</td><td>" + soilStatus + "</td></tr>";

  if (motorStatus == "ON")
    page += "<tr><td>Motor Status</td><td class='statusOn'>ON 💧</td></tr>";
  else
    page += "<tr><td>Motor Status</td><td class='statusOff'>OFF</td></tr>";

  page += "</table><br>";

  page += "<p>Page Auto Refreshes Every 3 Seconds</p>";
  page += "<meta http-equiv='refresh' content='3' />";
  page += "</body></html>";

  server.send(200, "text/html", page);
}

void setup() {
  Serial.begin(115200);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW);

  Serial.println("\nConnecting to WiFi...");
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\n✅ WiFi Connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.begin();
  Serial.println("🌐 Web Server Started...");
}

void loop() {
  server.handleClient();
}
