#include <ESP8266WiFi.h>

// 🌐 Wi-Fi Credentials
const char* ssid = "Divyasree";
const char* password = "lavadivya";

// ⚙️ Pin Configuration
const int soilSensorPin = A0;   // Soil moisture analog input
const int relayPin = D1;        // Relay control pin

// 💧 Moisture Threshold
const int threshold = 400;      // Adjust based on your sensor (0–1023)
WiFiServer server(80);

void setup() {
  Serial.begin(115200);
  pinMode(relayPin, OUTPUT);
  digitalWrite(relayPin, HIGH); // Keep pump OFF initially (active LOW relay)

  Serial.println("Connecting to WiFi...");
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\n✅ WiFi Connected!");
  Serial.print("📶 IP Address: ");
  Serial.println(WiFi.localIP());

  server.begin();
}

void loop() {
  int sensorValue = analogRead(soilSensorPin);
  String pumpStatus;

  if (sensorValue > threshold) {
    digitalWrite(relayPin, HIGH); // Turn OFF pump
    pumpStatus = "OFF";
  } else {
    digitalWrite(relayPin, LOW);  // Turn ON pump
    pumpStatus = "ON";
  }

  WiFiClient client = server.available();
  if (client) {
    String request = client.readStringUntil('\r');
    client.flush();

    // 🌐 HTML Webpage
    String html = "<!DOCTYPE html><html><head><meta http-equiv='refresh' content='3'>";
    html += "<title>Smart Irrigation System</title>";
    html += "<style>";
    html += "body { font-family: Arial; background-color:#e8f5e9; text-align:center; }";
    html += "table { margin:auto; border-collapse: collapse; width:60%; }";
    html += "th, td { border:1px solid #4CAF50; padding:12px; }";
    html += "th { background:#4CAF50; color:white; }";
    html += "</style></head><body>";
    html += "<h2>🌱 Smart Irrigation Monitoring</h2>";
    html += "<table>";
    html += "<tr><th>Parameter</th><th>Value</th></tr>";
    html += "<tr><td>Soil Moisture (0–1023)</td><td>" + String(sensorValue) + "</td></tr>";
    html += "<tr><td>Pump Status</td><td><b>" + pumpStatus + "</b></td></tr>";
    html += "</table><br>";
    html += "<p>Threshold Value: " + String(threshold) + "</p>";
    html += "<p>Page refreshes every 3 seconds</p>";
    html += "</body></html>";

    client.println("HTTP/1.1 200 OK");
    client.println("Content-Type: text/html");
    client.println("Connection: close");
    client.println();
    client.println(html);
    client.stop();
  }

  delay(1000);
}
