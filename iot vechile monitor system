#include <ESP8266WiFi.h>

const char* ssid = "Divyasree";     
const char* password = "lavadivya"; 

WiFiServer server(80);

#define MQ135_PIN A0
#define LED_PIN D1

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  Serial.println();
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  // Wait for connection
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("✅ WiFi connected!");
  Serial.print("📡 IP Address: ");
  Serial.println(WiFi.localIP());

  server.begin();
  Serial.println("🌐 Web server started");
}

void loop() {
  WiFiClient client = server.available();

  int sensorValue = analogRead(MQ135_PIN);

  // Convert sensor value to gas levels (simulated)
  float co  = sensorValue * 0.1;   // CO in ppm
  float co2 = sensorValue * 0.12;  // CO2 in ppm
  float no2 = sensorValue * 0.08;  // NO2 in ppm

  // Debug info on Serial
  Serial.print("CO: ");  Serial.print(co);
  Serial.print(" ppm | CO2: "); Serial.print(co2);
  Serial.print(" ppm | NO2: "); Serial.println(no2);

  // LED alert condition (linked to same logic as table)
  bool isHigh = (co > 400 || co2 > 400 || no2 > 400);
  digitalWrite(LED_PIN, isHigh ? HIGH : LOW);

  if (client) {
    String html = "<!DOCTYPE html><html><head>";
    html += "<meta http-equiv='refresh' content='2'>"; // Auto refresh every 2 sec
    html += "<title>Vehicle Gas Monitoring</title>";
    html += "<style>";
    html += "body{font-family:Arial;background:#f5f5f5;text-align:center;}";
    html += "h2{color:#333;margin-top:20px;}";
    html += "table{margin:20px auto;border:2px solid #333;border-collapse:collapse;width:400px;}";
    html += "th,td{border:1px solid #333;padding:10px;font-size:18px;}";
    html += "th{background:#333;color:white;}";
    html += ".high{background:#ff4d4d;color:white;font-weight:bold;}";
    html += ".normal{background:#d4edda;color:#155724;font-weight:bold;}";
    html += "</style></head><body>";

    html += "<h2>🚗 Vehicle Gas Monitoring System</h2>";
    html += "<table>";
    html += "<tr><th>Gas Type</th><th>Value (ppm)</th><th>Status</th></tr>";

    // CO
    html += "<tr><td>Carbon Monoxide (CO)</td><td>" + String(co) + "</td><td class='";
    html += (co > 400) ? "high'>⚠️ HIGH" : "normal'>✅ NORMAL";
    html += "</td></tr>";

    // CO2
    html += "<tr><td>Carbon Dioxide (CO₂)</td><td>" + String(co2) + "</td><td class='";
    html += (co2 > 400) ? "high'>⚠️ HIGH" : "normal'>✅ NORMAL";
    html += "</td></tr>";

    // NO2
    html += "<tr><td>Nitrogen Dioxide (NO₂)</td><td>" + String(no2) + "</td><td class='";
    html += (no2 > 400) ? "high'>⚠️ HIGH" : "normal'>✅ NORMAL";
    html += "</td></tr>";

    // Overall system status
    html += "<tr><th colspan='2'>System Status</th><td class='";
    html += (isHigh) ? "high'>⚠️ ALERT" : "normal'>✅ SAFE";
    html += "</td></tr></table>";

    html += "<p><small>Page updates automatically every 2 seconds</small></p>";

    html += "</body></html>";

    // Send response to browser
    client.print("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n");
    client.print(html);
    client.stop();
  }

  delay(200);
}

